<launch>
  <set_env name="ROS_LOCALHOST_ONLY" value="1"/>
  <!-- 常驻网页待命；硬件只由网页经过预检后显式启动。 -->
  <arg name="port" default="8080"/>
  <arg name="slam_params_file" default=""/>
  <arg name="map_root" default="/home/jetson/luhao/my_nav_carcar/src/carcar_navigation/maps/mapping_sessions"/>
  <node pkg="carcar_mapping_console" exec="mapping_web_gateway" name="mapping_web_gateway" output="screen">
    <param name="mode" value="standby"/>
    <param name="port" value="$(var port)"/>
    <param name="map_root" value="$(var map_root)"/>
    <param name="slam_params_file" value="$(var slam_params_file)" type="str"/>
  </node>
</launch>
