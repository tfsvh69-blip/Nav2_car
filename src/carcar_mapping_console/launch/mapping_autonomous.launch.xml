<launch>
  <!-- NAV-018独立组合；默认不启硬件。不与旧建图或AMCL巡检组合并开。 -->
  <arg name="async_ros_publication" default="true"/>
  <set_env name="ROS_LOCALHOST_ONLY" value="1"/>
  <!-- 仅本次应用子进程使用官方异步发包；保持原QoS、短队列与全部时限。 -->
  <set_env name="RMW_FASTRTPS_USE_QOS_FROM_XML" value="0"/>
  <set_env if="$(var async_ros_publication)" name="RMW_FASTRTPS_PUBLICATION_MODE" value="ASYNCHRONOUS"/>
  <set_env unless="$(var async_ros_publication)" name="RMW_FASTRTPS_PUBLICATION_MODE" value="SYNCHRONOUS"/>
  <set_env name="LD_LIBRARY_PATH" value="$(find-pkg-prefix carcar_tf2_compat)/lib/carcar_tf2_compat:$(env LD_LIBRARY_PATH)"/>
  <arg name="start_hardware" default="false"/><arg name="mode" default="new"/>
  <arg name="explore_seconds" default="2400.0"/>
  <arg name="control_mode" default="manual"/><arg name="task_id" default=""/>
  <arg name="recovery_enabled" default="true"/>
  <arg name="path_aware_ranking" default="false"/>
  <arg name="prefer_observation_clearance" default="true"/>
  <arg name="restricted_manual_enabled" default="true"/>
  <arg name="auto_execution_sweep" default="true"/>
  <arg name="obstacle_wait_enabled" default="true"/>
  <arg name="obstacle_escape_enabled" default="false"/>
  <arg name="cost_params" default="$(find-pkg-share carcar_mapping_autonomy)/config/nav2_clearance.yaml"/>
  <arg name="continuous_exploration" default="true"/>
  <arg name="live_controls_enabled" default="true"/>
  <let name="navigation_map_topic" value="/map"/>
  <let if="$(var live_controls_enabled)" name="navigation_map_topic" value="/mapping/navigation_map"/>
  <arg name="tuning_defaults_file" default="$(env HOME)/.local/state/carcar_mapping_console/tuning-defaults.json"/>
  <arg name="handoff_distance_m" default="0.25"/>
  <arg name="obstacle_escape_field_validated" default="false"/>
  <!-- 普通与前瞻探索共用近期可信图；可显式关闭连续模式作同条件对照。 -->
  <arg name="online_snapshots" default="true"/>
  <arg name="snapshot_interval_seconds" default="10.0"/>
  <arg name="bt_params" default="$(find-pkg-share carcar_mapping_autonomy)/config/nav2_continuous.yaml"/>
  <arg name="checkpoint_root" default="$(env CARCAR_MAPPING_RECOVERY_ROOT /home/jetson/luhao/my_nav_carcar/log/mapping_recovery)"/>
  <arg name="bundle_id" default=""/><arg name="start_gateway" default="true"/>
  <arg name="start_camera" default="false"/><arg name="require_video" default="false"/>
  <arg name="serial_port" default="/dev/myserial"/>
  <arg name="lidar_port" default="/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0"/>
  <arg name="map_root" default="/home/jetson/luhao/my_nav_carcar/src/carcar_navigation/maps/mapping_sessions"/>
  <arg name="slam_params_file" default="$(find-pkg-share carcar_navigation)/config/slam_toolbox.yaml"/>
  <arg name="controller_params" default="$(find-pkg-share carcar_mapping_autonomy)/config/controller_shim_rpp.yaml"/>
  <arg name="port" default="8080"/>
  <arg name="web_root" default="$(find-pkg-share carcar_mapping_console)/web"/>
  <arg name="record_raw_bag" default="true"/>
  <group if="$(var start_hardware)">
    <group scoped="true">
      <set_remap from="/cmd_vel" to="/mapping/cmd_vel"/>
      <include file="$(find-pkg-share carcar_bringup)/launch/robot.launch.xml">
        <arg name="serial_port" value="$(var serial_port)"/>
        <arg name="speed_params_file" value="$(find-pkg-share carcar_mapping_console)/config/mapping_limits_candidate.yaml"/>
      </include>
    </group>
    <include file="$(find-pkg-share carcar_lidar)/launch/lidar.launch.xml"><arg name="serial_port" value="$(var lidar_port)"/></include>
    <include if="$(var start_camera)" file="$(find-pkg-share carcar_camera)/launch/camera_mapping_rgb.launch.xml"/>
  </group>
  <node pkg="laser_filters" exec="scan_to_scan_filter_chain" name="scan_to_scan_filter_chain" output="screen">
    <param from="$(find-pkg-share carcar_mapping_autonomy)/config/laser_distance.yaml"/>
    <remap from="scan" to="/scan"/><remap from="scan_filtered" to="/scan/filtered"/>
  </node>
  <node pkg="carcar_mapping_autonomy" exec="mapping_slam" name="slam_toolbox" output="screen">
    <param from="$(var slam_params_file)"/><param name="scan_topic" value="/mapping/slam_scan"/><param name="use_map_saver" value="false"/>
    <!-- 静止首帧加最多12个新扫描；原通行计数、占用和运动接纳门槛不变。 -->
    <param name="startup_stationary_scans" value="12"/>
    <param name="startup_stationary_window" value="5.0"/>
    <param name="online_snapshots" value="$(var online_snapshots)"/>
    <param name="snapshot_root" value="$(var checkpoint_root)"/>
  </node>
  <node pkg="carcar_mapping_console" exec="mapping_teleop_guard" name="mapping_teleop_guard" output="screen">
    <param name="require_video" value="false"/><remap from="/mapping/cmd_vel" to="/mapping/manual_cmd_vel"/>
  </node>
  <node if="$(var live_controls_enabled)" pkg="carcar_mapping_autonomy" exec="mapping_task_scene" name="mapping_task_scene" output="screen"><param name="task_id" value="$(var task_id)" type="str"/></node>
  <node if="$(var live_controls_enabled)" pkg="carcar_mapping_autonomy" exec="mapping_tuning" name="mapping_tuning" output="screen">
    <param name="task_id" value="$(var task_id)" type="str"/><param name="defaults_file" value="$(var tuning_defaults_file)"/>
  </node>
  <include file="$(find-pkg-share carcar_mapping_autonomy)/launch/navigation.launch.xml">
    <arg name="live_controls_enabled" value="$(var live_controls_enabled)"/>
    <arg name="navigation_map_topic" value="$(var navigation_map_topic)"/>
    <arg name="controller_params" value="$(var controller_params)"/>
    <arg name="cost_params" value="$(var cost_params)"/>
    <arg name="obstacle_escape_enabled" value="$(var obstacle_escape_enabled)"/>
    <arg name="bt_params" value="$(var bt_params)"/>
  </include>
  <node pkg="carcar_mapping_autonomy" exec="mapping_autonomy" name="mapping_autonomy" output="screen">
    <param name="control_mode" value="$(var control_mode)"/><param name="task_id" value="$(var task_id)" type="str"/>
    <param name="live_controls_enabled" value="$(var live_controls_enabled)"/>
    <param name="navigation_map_topic" value="$(var navigation_map_topic)"/>
    <param name="handoff_distance_m" value="$(var handoff_distance_m)"/>
    <param name="obstacle_escape_field_validated" value="$(var obstacle_escape_field_validated)"/>
    <param name="explore_seconds" value="$(var explore_seconds)"/>
    <param name="recovery_enabled" value="$(var recovery_enabled)"/>
    <param name="continuous_exploration" value="$(var continuous_exploration)"/>
    <param name="fixed_observation_goals" value="$(var path_aware_ranking)"/>
    <param name="prefer_observation_clearance" value="$(var prefer_observation_clearance)"/>
    <param name="restricted_manual_enabled" value="$(var restricted_manual_enabled)"/>
    <param name="auto_execution_sweep" value="$(var auto_execution_sweep)"/>
    <param name="obstacle_wait_enabled" value="$(var obstacle_wait_enabled)"/>
    <param name="obstacle_escape_enabled" value="$(var obstacle_escape_enabled)"/>
    <param name="online_snapshots" value="$(var online_snapshots)"/>
    <param name="exploration_behavior_tree" value="$(find-pkg-share carcar_mapping_autonomy)/behavior_trees/navigate_to_pose_exploration.xml"/>
    <param name="snapshot_interval_seconds" value="$(var snapshot_interval_seconds)"/>
  </node>
  <include if="$(var recovery_enabled)" file="$(find-pkg-share carcar_mapping_autonomy)/launch/recovery.launch.xml">
    <arg name="task_id" value="$(var task_id)"/>
    <arg name="checkpoint_root" value="$(var checkpoint_root)"/>
    <arg name="online_snapshots" value="$(var online_snapshots)"/>
  </include>
  <node if="$(var path_aware_ranking)" pkg="carcar_mapping_autonomy" exec="mapping_frontier_ranker" name="mapping_frontier_ranker" output="screen">
    <param name="prefer_observation_clearance" value="$(var prefer_observation_clearance)"/>
  </node>
  <node pkg="explore_lite" exec="explore" name="explore_node" output="screen">
    <param from="$(find-pkg-share carcar_mapping_autonomy)/config/explore.yaml"/>
    <param name="path_aware_ranking" value="$(var path_aware_ranking)"/><param name="costmap_topic" value="$(var navigation_map_topic)"/>
  </node>
  <node if="$(var record_raw_bag)" pkg="carcar_navigation" exec="nav_event_logger" name="nav_event_logger" output="screen">
    <param name="record_raw_bag" value="true"/><param name="raw_bag_max_duration_s" value="3000.0"/>
    <param name="raw_bag_max_bytes" value="1073741824"/><param name="raw_bag_split_bytes" value="268435456"/>
    <param name="raw_bag_min_free_bytes" value="2147483648"/>
  </node>
  <node if="$(var start_gateway)" pkg="carcar_mapping_console" exec="mapping_web_gateway" name="mapping_web_gateway" output="screen">
    <param name="web_root" value="$(var web_root)"/>
    <param name="mode" value="$(var mode)"/><param name="bundle_id" value="$(var bundle_id)" type="str"/>
    <param name="map_root" value="$(var map_root)"/><param name="port" value="$(var port)"/>
    <param name="autonomy_enabled" value="true"/>
    <param name="task_id" value="$(var task_id)" type="str"/><param name="control_mode" value="$(var control_mode)"/>
  </node>
</launch>
