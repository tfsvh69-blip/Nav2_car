<?xml version="1.0" encoding="UTF-8"?>
<!-- 桌面域32仅显示：peer地址按车端当前IP维护，端口0按当前域展开初始参与者端口。 -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <participant profile_name="inspection_display_peer" is_default_profile="true">
    <rtps>
      <builtin>
        <initialPeersList>
          <locator><udpv4><address>192.168.5.11</address><port>0</port></udpv4></locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
