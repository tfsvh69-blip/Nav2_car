<launch>
  <!-- APP-001独立实机入口；默认不启动硬件。不得与建图/原导航入口并行。 -->
  <arg name="real_hardware" default="false"/>
  <arg name="enable_navigation" default="false"/>
  <arg name="map" default="$(find-pkg-share carcar_navigation)/maps/nav004_20260914_093032.yaml"/>
  <arg name="port" default="8081"/>
  <arg name="data_root" default="/home/jetson/.local/share/carcar_inspection"/>
  <group if="$(var real_hardware)">
    <include file="$(find-pkg-share carcar_base)/launch/base.launch.xml">
      <arg name="enable_inspection_interface" value="true"/>
    </include>
    <include file="$(find-pkg-share carcar_description)/launch/description.launch.xml"/>
    <include file="$(find-pkg-share carcar_lidar)/launch/lidar.launch.xml"/>
    <include file="$(find-pkg-share carcar_navigation)/launch/localization_experimental.launch.xml">
      <arg name="map" value="$(var map)"/>
      <arg name="use_rviz" value="false"/>
    </include>
    <node pkg="realsense2_camera" exec="realsense2_camera_node" namespace="camera" name="camera" output="screen">
      <param from="$(find-pkg-share carcar_camera)/config/d435_navigation.yaml"/>
      <param name="enable_color" value="true"/>
      <param name="rgb_camera.color_profile" value="640x480x6"/>
      <param name="rgb_camera.color_format" value="RGB8"/>
      <remap from="/camera/camera/depth/color/points" to="/camera/depth/points"/>
    </node>
    <node pkg="carcar_camera" exec="depth_cloud_filter" name="depth_cloud_filter" output="screen">
      <param from="$(find-pkg-share carcar_camera)/config/depth_filter_stvl_experimental.yaml"/>
      <param name="input_topic" value="/inspection/navigation/points"/>
    </node>
    <node pkg="carcar_camera" exec="depth_layer_supervisor" name="depth_layer_supervisor" output="screen">
      <param from="$(find-pkg-share carcar_camera)/config/depth_filter_stvl_experimental.yaml"/>
    </node>
    <group>
      <set_remap from="/cmd_vel" to="/inspection/navigation/cmd_vel"/>
      <include file="$(find-pkg-share carcar_navigation)/launch/navigation_experimental.launch.xml">
        <arg name="sensor_params_file" value="$(find-pkg-share carcar_navigation)/config/nav2_depth_stvl_experimental.yaml"/>
        <arg name="enable_indicator" value="false"/>
      </include>
    </group>
  </group>
  <include file="$(find-pkg-share carcar_inspection)/launch/console.launch.xml">
    <arg name="port" value="$(var port)"/>
    <arg name="data_root" value="$(var data_root)"/>
    <arg name="enable_hardware" value="$(var real_hardware)"/>
    <arg name="enable_navigation" value="$(var enable_navigation)"/>
  </include>
</launch>
