<launch>
  <arg name="live_controls_enabled" default="false"/>
  <arg name="navigation_map_topic" default="/map"/>
  <arg name="base_params" default="$(find-pkg-share carcar_navigation)/config/nav2.yaml"/>
  <arg name="params" default="$(find-pkg-share carcar_mapping_autonomy)/config/nav2_mapping.yaml"/>
  <let name="live_params" value="$(var params)"/>
  <let if="$(var live_controls_enabled)" name="live_params" value="$(find-pkg-share carcar_mapping_autonomy)/config/nav2_live.yaml"/>
  <arg name="obstacle_escape_enabled" default="false"/>
  <arg name="cost_params" default="$(find-pkg-share carcar_mapping_autonomy)/config/nav2_clearance.yaml"/>
  <arg name="controller_params" default="$(find-pkg-share carcar_mapping_autonomy)/config/controller_shim_rpp.yaml"/>
  <arg name="bt_params" default="$(find-pkg-share carcar_mapping_autonomy)/config/nav2_mapping.yaml"/>
  <arg name="retreat_params" default="$(find-pkg-share carcar_mapping_autonomy)/config/nav2_mapping.yaml"/>
  <let if="$(var obstacle_escape_enabled)" name="retreat_params" value="$(find-pkg-share carcar_mapping_autonomy)/config/retreat_candidate.yaml"/>
  <node pkg="carcar_mapping_autonomy" exec="mapping_known_space" name="mapping_known_space" output="screen"><param name="navigation_map_topic" value="$(var navigation_map_topic)"/></node>
  <node pkg="nav2_controller" exec="controller_server" name="controller_server" output="screen">
    <param from="$(var base_params)"/><param from="$(var params)"/><param from="$(var live_params)"/><param from="$(var cost_params)"/>
    <param from="$(find-pkg-share carcar_mapping_autonomy)/config/controller_rpp.yaml"/>
    <param from="$(var controller_params)"/>
    <remap from="cmd_vel" to="/mapping/nav_raw"/>
  </node>
  <node pkg="nav2_velocity_smoother" exec="velocity_smoother" name="velocity_smoother" output="screen">
    <param from="$(var base_params)"/><param from="$(var params)"/><param from="$(var live_params)"/><param from="$(var cost_params)"/>
    <param from="$(var retreat_params)"/>
    <remap from="cmd_vel" to="/mapping/nav_raw"/><remap from="cmd_vel_smoothed" to="/mapping/auto_cmd_vel"/>
  </node>
  <node pkg="nav2_planner" exec="planner_server" name="planner_server" output="screen">
    <param from="$(var base_params)"/><param from="$(var params)"/><param from="$(var live_params)"/><param from="$(var cost_params)"/>
  </node>
  <node if="$(var obstacle_escape_enabled)" pkg="nav2_behaviors" exec="behavior_server" name="behavior_server" output="screen">
    <param from="$(find-pkg-share carcar_mapping_autonomy)/config/retreat_candidate.yaml"/>
    <remap from="cmd_vel" to="/mapping/nav_raw"/>
  </node>
  <node pkg="nav2_bt_navigator" exec="bt_navigator" name="bt_navigator" output="screen">
    <param from="$(var base_params)"/><param from="$(var params)"/><param from="$(var live_params)"/><param from="$(var cost_params)"/>
    <param from="$(var bt_params)"/>
    <param name="default_nav_to_pose_bt_xml" value="$(find-pkg-share carcar_mapping_autonomy)/behavior_trees/navigate_to_pose_mapping.xml"/>
    <param name="default_nav_through_poses_bt_xml" value="$(find-pkg-share carcar_navigation)/behavior_trees/navigate_through_poses_no_recovery.xml"/>
  </node>
  <node pkg="nav2_collision_monitor" exec="collision_monitor" name="collision_monitor" output="screen">
    <param from="$(find-pkg-share carcar_mapping_autonomy)/config/collision.yaml"/>
  </node>
  <timer period="3.0">
    <node pkg="carcar_mapping_autonomy" exec="mapping_lifecycle_manager" name="lifecycle_manager_navigation" output="screen">
      <param from="$(var params)"/>
      <param from="$(var retreat_params)"/>
    </node>
  </timer>
</launch>
