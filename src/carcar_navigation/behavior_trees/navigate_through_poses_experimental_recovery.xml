<!-- NAV-008 多目标实验恢复树；恢复后保留 goals 并重新规划当前剩余路线。 -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode name="ntppe_NavigationRecovery" number_of_retries="3">
      <PipelineSequence name="ntppe_NavigateWithReplanning">
        <WaitForLocalizationStatus name="ntppe_WaitForLocalizationStatus" health_topic="/localization_monitor/ready" timeout="2.0"/>
        <RateController name="ntppe_RateController" hz="1.0">
          <ComputePathThroughPoses name="ntppe_ComputePathThroughPoses" goals="{goals}" path="{path}" planner_id="GridBased"/>
        </RateController>
        <ReactiveSequence name="ntppe_LocalizationGate">
          <LocalizationHealthy name="ntppe_LocalizationHealthy" health_topic="/localization_monitor/ready"/>
          <FollowPath name="ntppe_FollowPath" path="{path}" controller_id="FollowPath"/>
        </ReactiveSequence>
      </PipelineSequence>
      <ReactiveFallback name="ntppe_RecoveryFallback">
        <GoalUpdated name="ntppe_GoalUpdated"/>
        <Fallback name="ntppe_LocalizationOrLimitedRecovery">
          <Sequence name="ntppe_LimitedRecoveryWhenLocalized">
            <LocalizationHealthy name="ntppe_LocalizationHealthyBeforeRecovery" health_topic="/localization_monitor/ready"/>
            <RoundRobin name="ntppe_LimitedRecovery">
              <Wait name="ntppe_WaitForReplan" wait_duration="2.0"/>
              <Spin name="ntppe_SpinForObservability" spin_dist="1.570796" time_allowance="10.0"/>
              <Fallback name="ntppe_BackUpOnlyWhenRearClear">
                <Sequence name="ntppe_RearClearAndBackUp">
                  <RearClear name="ntppe_RearClear" costmap_topic="/local_costmap/costmap_raw" scan_topic="/scan" max_data_age="0.5" backup_distance="0.15"/>
                  <BackUp name="ntppe_BackUp" backup_dist="0.15" backup_speed="0.05" time_allowance="6.0"/>
                </Sequence>
                <Wait name="ntppe_BackUpDeniedWait" wait_duration="2.0"/>
              </Fallback>
            </RoundRobin>
          </Sequence>
          <RecoverLocalization name="ntppe_RecoverLocalization" health_topic="/localization_monitor/ready" recovery_allowed_topic="/localization_monitor/recovery_allowed" local_timeout="10.0" global_timeout="20.0"/>
        </Fallback>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
