<!-- NAV-012 修复版：监督节点负责取消/停稳/新目标与 90s 总预算；旧故障记录保留在测试记录中。 -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoverySupervisor name="ntpe_RecoverySupervisor" goal="{goal}">
      <PipelineSequence name="ntpe_NavigateWithReplanning">
        <WaitForLocalizationStatus name="ntpe_WaitForLocalizationStatus" timeout="2.0"/>
        <RateController name="ntpe_RateController" hz="1.0">
          <SafeComputePathToPose name="ntpe_ComputePathToPose" goal="{goal}" path="{path}" planner_id="GridBased" timeout="5.0"/>
        </RateController>
        <ProgressGuard name="ntpe_ProgressGuard" path="{path}" goal="{goal}" linear_stagnation_timeout="3.0" linear_displacement_threshold="0.03" angular_stagnation_timeout="3.0" angular_convergence_threshold="0.10" max_rotation_budget="8.0" heading_flip_threshold="0.35" max_heading_flips="3">
          <SafeFollowPath name="ntpe_FollowPath" path="{path}" controller_id="FollowPath"/>
        </ProgressGuard>
      </PipelineSequence>
      <Fallback name="ntpe_RecoveryFallback">
        <Sequence name="ntpe_LocalizationRecovery">
          <Inverter><LocalizationHealthy name="ntpe_CheckLocalization"/></Inverter>
          <RecoverLocalization name="ntpe_RecoverLocalization" local_timeout="10.0" global_timeout="20.0"/>
        </Sequence>
        <ReactiveSequence name="ntpe_MotionRecoveryGate">
          <RecoveryInputsReady name="ntpe_RecoveryInputsReady"/>
          <Fallback name="ntpe_OrderedEscape">
            <Sequence name="ntpe_RearClearAndBackUp">
              <RearClear name="ntpe_RearClear" backup_distance="0.20" max_data_age="0.5"/>
              <SafeBackUp name="ntpe_BackUp" backup_dist="0.20" backup_speed="0.05" time_allowance="6.0"/>
            </Sequence>
            <ControlledSpin name="ntpe_ControlledSpin" path="{path}" goal="{goal}" max_spin_angle="1.570796" time_allowance="10.0"/>
          </Fallback>
        </ReactiveSequence>
        <ParkAndObserve name="ntpe_ParkAndObserve" path="{path}" goal="{goal}" observe_duration="8.0"/>
      </Fallback>
    </RecoverySupervisor>
  </BehaviorTree>
</root>
