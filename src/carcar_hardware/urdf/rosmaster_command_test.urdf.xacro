<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="carcar_command_test">
  <xacro:arg name="serial_port" default="/dev/myserial"/>
  <xacro:arg name="motion_enabled" default="false"/>
  <xacro:arg name="left_command_sign" default="1"/>
  <xacro:arg name="right_command_sign" default="1"/>
  <xacro:arg name="left_encoder_sign" default="1"/>
  <xacro:arg name="right_encoder_sign" default="1"/>

  <!--
    仅供架空底层测试。下列 0.05 m、0.20 m 和 1320 count/rev
    均为显式临时值，不是正式底盘参数，不能用于里程计或导航验收。
  -->
  <link name="base_link"/>
  <link name="left_wheel_link"/>
  <link name="right_wheel_link"/>
  <link name="imu_link"/>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.10 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.10 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <ros2_control name="RosmasterCommandTestSystem" type="system">
    <hardware>
      <plugin>carcar_hardware/RosmasterSystem</plugin>
      <param name="serial_port">$(arg serial_port)</param>
      <param name="car_type">1</param>
      <param name="motion_enabled">$(arg motion_enabled)</param>
      <param name="wheel_radius">0.05</param>
      <param name="wheel_separation">0.20</param>
      <param name="encoder_counts_per_revolution">1320.0</param>
      <param name="left_wheel_command_sign">$(arg left_command_sign)</param>
      <param name="right_wheel_command_sign">$(arg right_command_sign)</param>
      <param name="left_wheel_encoder_sign">$(arg left_encoder_sign)</param>
      <param name="right_wheel_encoder_sign">$(arg right_encoder_sign)</param>
      <param name="max_linear_x">0.10</param>
      <param name="max_angular_z">0.50</param>
      <param name="encoder_timeout">0.20</param>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="encoder_count"/>
      <state_interface name="encoder_velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="encoder_count"/>
      <state_interface name="encoder_velocity"/>
    </joint>
    <sensor name="board_imu">
      <state_interface name="orientation.x"/>
      <state_interface name="orientation.y"/>
      <state_interface name="orientation.z"/>
      <state_interface name="orientation.w"/>
      <state_interface name="angular_velocity.x"/>
      <state_interface name="angular_velocity.y"/>
      <state_interface name="angular_velocity.z"/>
      <state_interface name="linear_acceleration.x"/>
      <state_interface name="linear_acceleration.y"/>
      <state_interface name="linear_acceleration.z"/>
    </sensor>
  </ros2_control>
</robot>
