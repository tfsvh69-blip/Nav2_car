<?xml version="1.0"?>
<package format="3">
  <name>carcar_base</name>
  <version>0.1.0</version>
  <description>ROS 2 hardware boundary for the Carcar mobile base.</description>
  <maintainer email="maintainer@example.com">carcar maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>rosmaster_vendor</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>carcar_interfaces</depend>

  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rqt_plot</exec_depend>
  <exec_depend>rqt_reconfigure</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
