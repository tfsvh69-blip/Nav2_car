<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="box_visual" params="name xyz rpy size material">
    <visual name="${name}">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry><box size="${size}"/></geometry>
      <material name="${material}"/>
    </visual>
  </xacro:macro>

  <xacro:macro name="cylinder_visual" params="name xyz rpy radius length material">
    <visual name="${name}">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
      <material name="${material}"/>
    </visual>
  </xacro:macro>

  <xacro:macro name="mecanum_wheel" params="name x y mesh_file">
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <link name="${name}_link">
      <visual name="${name}_tire">
        <!-- 开源 STL 原始外廓约 101.2 × 50 mm，缩放到实物 60 × 31 mm。 -->
        <geometry>
          <mesh filename="package://carcar_description/meshes/mecanum/${mesh_file}"
            scale="0.0005928 0.0006200 0.0005928"/>
        </geometry>
        <material name="wheel_white"/>
      </visual>
      <visual name="${name}_hub">
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="0.012" length="${wheel_width}"/></geometry>
        <material name="metal_dark"/>
      </visual>
      <collision name="${name}_collision">
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="drive_motor_visual" params="name x y">
    <xacro:cylinder_visual name="${name}_motor" xyz="${x} ${y} 0"
      rpy="${pi / 2} 0 0" radius="${motor_radius}" length="${motor_length}"
      material="metal_silver"/>
    <xacro:cylinder_visual name="${name}_shaft" xyz="${x} ${y * 1.34} 0"
      rpy="${pi / 2} 0 0" radius="0.004" length="0.018" material="metal_dark"/>
  </xacro:macro>

  <xacro:macro name="chassis_standoff" params="name x y">
    <xacro:cylinder_visual name="${name}"
      xyz="${x} ${y} ${(lower_plate_center_z + upper_plate_center_z) / 2}"
      rpy="0 0 0" radius="${chassis_standoff_radius}"
      length="${upper_plate_center_z - lower_plate_center_z}" material="brass"/>
  </xacro:macro>

  <xacro:macro name="carcar_chassis">
    <!-- base_link 位于四轮轮心矩形中心，并与轮轴等高。 -->
    <link name="base_link">
      <xacro:box_visual name="lower_chassis_plate"
        xyz="0 0 ${lower_plate_center_z}" rpy="0 0 0"
        size="${lower_plate_x} ${lower_plate_y} ${lower_plate_z}" material="metal_silver"/>
      <xacro:box_visual name="upper_chassis_plate"
        xyz="0 0 ${upper_plate_center_z}" rpy="0 0 0"
        size="${lower_plate_x} ${lower_plate_y} ${lower_plate_z}" material="metal_silver"/>

      <xacro:drive_motor_visual name="front_left" x="${wheel_center_x}" y="0.060"/>
      <xacro:drive_motor_visual name="front_right" x="${wheel_center_x}" y="-0.060"/>
      <xacro:drive_motor_visual name="rear_left" x="${-wheel_center_x}" y="0.060"/>
      <xacro:drive_motor_visual name="rear_right" x="${-wheel_center_x}" y="-0.060"/>

      <xacro:chassis_standoff name="front_left_chassis_standoff" x="0.070" y="0.060"/>
      <xacro:chassis_standoff name="front_right_chassis_standoff" x="0.070" y="-0.060"/>
      <xacro:chassis_standoff name="rear_left_chassis_standoff" x="-0.070" y="0.060"/>
      <xacro:chassis_standoff name="rear_right_chassis_standoff" x="-0.070" y="-0.060"/>

      <xacro:box_visual name="rosmaster_control_board" xyz="0 0 0.022" rpy="0 0 0"
        size="0.075 0.060 0.006" material="pcb_blue"/>
      <xacro:box_visual name="battery_pack" xyz="-0.020 0 -0.008" rpy="0 0 0"
        size="0.090 0.048 0.024" material="plastic_black"/>

      <collision name="lower_chassis_collision">
        <origin xyz="0 0 ${(ground_clearance - wheel_radius + upper_plate_center_z + lower_plate_z / 2) / 2}"
          rpy="0 0 0"/>
        <geometry><box size="${lower_plate_x} ${lower_plate_y} ${upper_plate_center_z + lower_plate_z / 2 - ground_clearance + wheel_radius}"/></geometry>
      </collision>
    </link>

    <xacro:mecanum_wheel name="front_left_wheel"
      x="${wheel_center_x}" y="${wheel_center_y}" mesh_file="mecanum_wheel_left.stl"/>
    <xacro:mecanum_wheel name="front_right_wheel"
      x="${wheel_center_x}" y="${-wheel_center_y}" mesh_file="mecanum_wheel_right.stl"/>
    <xacro:mecanum_wheel name="rear_left_wheel"
      x="${-wheel_center_x}" y="${wheel_center_y}" mesh_file="mecanum_wheel_right.stl"/>
    <xacro:mecanum_wheel name="rear_right_wheel"
      x="${-wheel_center_x}" y="${-wheel_center_y}" mesh_file="mecanum_wheel_left.stl"/>

    <!-- 上层蓝色结构使用用户从 SolidWorks 导出的毫米制精确网格。 -->
    <joint name="upper_body_joint" type="fixed">
      <parent link="base_link"/>
      <child link="upper_body_link"/>
      <origin xyz="0 0 ${upper_deck_z}" rpy="0 0 0"/>
    </joint>
    <link name="upper_body_link">
      <visual name="upper_structure_mesh">
        <origin
          xyz="${overall_rear_x} 0.065 ${ground_clearance - wheel_radius - upper_deck_z}"
          rpy="${pi / 2} 0 0"/>
        <geometry>
          <mesh filename="package://carcar_description/meshes/vehicle/carcar_upper_structure.stl"
            scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="body_blue"/>
      </visual>

      <collision name="upper_body_collision">
        <origin xyz="${upper_deck_center_x} 0 ${body_collision_center_z - upper_deck_z}"
          rpy="0 0 0"/>
        <geometry><box size="${body_collision_x} ${body_collision_y} ${body_collision_z}"/></geometry>
      </collision>
    </link>

    <joint name="compute_joint" type="fixed">
      <parent link="base_link"/>
      <child link="compute_link"/>
      <origin xyz="${compute_xyz}" rpy="0 0 0"/>
    </joint>
    <link name="compute_link">
      <xacro:box_visual name="jetson_blue_enclosure" xyz="0 0 0" rpy="0 0 0"
        size="${compute_enclosure_x} ${compute_enclosure_y} ${compute_enclosure_z}"
        material="body_blue_dark"/>
      <xacro:box_visual name="jetson_carrier_board" xyz="0 0 -0.004" rpy="0 0 0"
        size="${compute_board_x} ${compute_board_y} ${compute_board_z}" material="pcb_green"/>
      <xacro:box_visual name="jetson_heatsink" xyz="-0.005 0 0.018" rpy="0 0 0"
        size="0.060 0.070 0.018" material="metal_dark"/>
      <xacro:box_visual name="jetson_connector_face"
        xyz="${compute_enclosure_x / 2 + 0.0005} 0 0" rpy="0 0 0"
        size="0.001 0.090 0.025" material="plastic_black"/>
      <xacro:box_visual name="jetson_usb_ports"
        xyz="${compute_enclosure_x / 2 + 0.001} 0.014 0" rpy="0 0 0"
        size="0.002 0.034 0.012" material="metal_silver"/>
      <xacro:box_visual name="jetson_ethernet_port"
        xyz="${compute_enclosure_x / 2 + 0.001} -0.024 0" rpy="0 0 0"
        size="0.002 0.015 0.014" material="metal_silver"/>
      <visual name="jetson_lower_mount_mesh">
        <origin xyz="-0.070 0.055 -0.003" rpy="${pi / 2} 0 0"/>
        <geometry>
          <mesh filename="package://carcar_description/meshes/vehicle/jetson_lower_mount.stl"
            scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="body_blue"/>
      </visual>
      <collision name="compute_collision">
        <geometry><box size="${compute_enclosure_x} ${compute_enclosure_y} ${compute_enclosure_z}"/></geometry>
      </collision>
    </link>
  </xacro:macro>
</robot>
